<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PixHide.WinUI3App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PixHide.WinUI3App"
    xmlns:toolkitconverters="using:CommunityToolkit.WinUI.Converters"
    xmlns:media="using:Microsoft.UI.Xaml.Media"
    xmlns:vm="using:PixHide.WinUI3App.ViewModels"
    xmlns:navigation="using:PixHide.WinUI3App.Navigation"
    xmlns:views="using:PixHide.WinUI3App.Views">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="HomeViewModelTemplate">
                <views:HomeView/>
            </DataTemplate>

            <DataTemplate x:Key="SettingsViewModelTemplate">
                <views:SettingsView/>
            </DataTemplate>

            <navigation:ViewModelTemplateSelector x:Key="VmTemplateSelector">
                <navigation:ViewModelTemplateSelector.HomeTemplate>
                    <StaticResource ResourceKey="HomeViewModelTemplate"/>
                </navigation:ViewModelTemplateSelector.HomeTemplate>

                <navigation:ViewModelTemplateSelector.SettingsTemplate>
                    <StaticResource ResourceKey="SettingsViewModelTemplate"/>
                </navigation:ViewModelTemplateSelector.SettingsTemplate>
            </navigation:ViewModelTemplateSelector>
        </ResourceDictionary>
    </Application.Resources>
</Application>
